# ──────────────────────────────────────────────────────────────────────────────
# Argmin — environment variables (EXAMPLE / template)
#
# Copy to `.env` and fill in. Nothing here is required to run the *default*
# (precomputed) scenario; the variables below configure live engine runs,
# alternate data sources, caching, rate-limiting and deploy.
#
# NOTE: Argmin is intentionally no-login / stateless / no user DB (see spec
# Part 3). There is deliberately NO DATABASE_URL or AUTH_SECRET here.
#
# In the monorepo this can be split into engine/.env and web/.env.local; the
# sections are separated below so that's a copy-paste away.
# ──────────────────────────────────────────────────────────────────────────────


# ==============================================================================
# ENGINE  (Python / FastAPI — engine/.env)
# ==============================================================================

# --- Runtime ------------------------------------------------------------------
ARGMIN_ENV=development                  # development | production
ARGMIN_LOG_LEVEL=INFO                   # structlog level: DEBUG|INFO|WARNING|ERROR
ARGMIN_LOG_JSON=false                   # true = JSON logs (prod), false = console

# --- API service --------------------------------------------------------------
ARGMIN_API_HOST=0.0.0.0
ARGMIN_API_PORT=8000
# Comma-separated origins allowed to call the engine (the web app).
# Use the exact deployed URL in production; "*" only for local dev.
ARGMIN_CORS_ALLOW_ORIGINS=http://localhost:3000

# --- Data source --------------------------------------------------------------
ARGMIN_DATA_SOURCE=yfinance             # yfinance | polygon | csv
# Only needed if ARGMIN_DATA_SOURCE=polygon (swappable provider).
POLYGON_API_KEY=

# --- Cache & reproducibility --------------------------------------------------
ARGMIN_DATA_DIR=./engine/data
ARGMIN_DUCKDB_PATH=./engine/data/argmin.duckdb
# Fixed seed so backtests / bootstrap CIs / random frontier cloud are byte-stable.
ARGMIN_RANDOM_SEED=42

# --- Live-run response cache & rate limiting ----------------------------------
ARGMIN_CACHE_TTL_SECONDS=86400
ARGMIN_RATE_LIMIT_PER_MINUTE=30


# ==============================================================================
# WEB  (Next.js / Vercel — web/.env.local)
# ==============================================================================

# --- Engine connection --------------------------------------------------------
API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_API_BASE_URL=/api

# --- Site ---------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Production values (see DEPLOY.md) ----------------------------------------
# Engine on a container host (Fly.io recommended — too heavy for Vercel Python's
# 250 MB limit). Web on Vercel. Set, per environment:
#   Engine (Fly secrets):  ARGMIN_ENV=production
#                          ARGMIN_CORS_ALLOW_ORIGINS=https://<your-web>.vercel.app
#   Web (Vercel env):      API_BASE_URL=https://argmin-engine.fly.dev
#                          NEXT_PUBLIC_SITE_URL=https://<your-web>.vercel.app

# ==============================================================================
# DEV TOOLING / DESIGN PIPELINE (optional — NOT needed at runtime)
# ==============================================================================
# The 21st-magic MCP server needs an API key — belongs in your MCP/client config,
# not the app at runtime. Listed here for convenience.
TWENTY_FIRST_API_KEY=
